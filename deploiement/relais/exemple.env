# /etc/youma-relais/<nom>.env — lisible par root seulement (chmod 600).
# Port local de cette instance : Caddy seul le joint (le pare-feu ferme ce port vers Internet).
YOUMA_PORT=8080
# Clé partagée avec le poste central (Administration → Commandes à distance → « Clé du relais »).
# 16 caractères au moins ; en tirer une avec : openssl rand -hex 24
YOUMA_RELAIS_CLE=
# SMS Orange Mali (facultatif). Sans ces trois lignes : simulation, le code s'affiche au client.
#YOUMA_ORANGE_CLIENT_ID=
#YOUMA_ORANGE_CLIENT_SECRET=
#YOUMA_ORANGE_EXPEDITEUR=+223XXXXXXXX
#YOUMA_ORANGE_NOM_EXPEDITEUR=Youma
